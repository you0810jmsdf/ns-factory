{
  "id": "holeshape",
  "page": "stitching",
  "title": "tut.holeshape.title",
  "steps": [
    {
      "say": "tut.holeshape.1",
      "click": "[data-tool=\"line\"]",
      "mode": "line"
    },
    {
      "drag": [
        20,
        45,
        120,
        45
      ]
    },
    {
      "mode": "stitch"
    },
    {
      "mouse": [
        25,
        45
      ],
      "press": true
    },
    {
      "mouse": [
        115,
        45
      ],
      "press": true,
      "wait": 600
    },
    {
      "say": "tut.holeshape.2",
      "click": "[data-tool=\"select\"]",
      "mode": "select",
      "mouse": [
        70,
        45
      ],
      "press": true
    },
    {
      "click": "#ctx-holeshape",
      "wait": 500
    },
    {
      "say": "tut.holeshape.3",
      "value": {
        "#holeShapeScope": "range",
        "#holeShapeKind": "round",
        "#holeShapeD": "1.5"
      }
    },
    {
      "click": "#holeShapeApply",
      "wait": 1000
    },
    {
      "say": "tut.holeshape.4",
      "value": {
        "#holeShapeKind": "diamond",
        "#holeShapeOnlyRound": true,
        "#holeShapeOnlyDiamond": false
      }
    },
    {
      "click": "#holeShapeApply",
      "wait": 1000
    },
    {
      "value": {
        "#holeShapeOnlyRound": false,
        "#holeShapeOnlyDiamond": true
      },
      "click": "#holeShapeWinClose"
    }
  ]
}
