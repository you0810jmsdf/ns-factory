{
  "id": "textfont",
  "page": "text-dimension",
  "title": "tut.textfont.title",
  "steps": [
    {
      "say": "tut.textfont.1",
      "click": "[data-tool=\"text\"]",
      "mode": "text"
    },
    {
      "mouse": [
        25,
        40
      ],
      "press": true
    },
    {
      "value": {
        "#textEditArea": "N's factory"
      }
    },
    {
      "click": "#textEditOk",
      "wait": 500
    },
    {
      "say": "tut.textfont.2",
      "click": "#ctx-textfont",
      "wait": 600
    },
    {
      "say": "tut.textfont.3",
      "value": {
        "#tfFont": "zenMaru"
      },
      "wait": 1000
    },
    {
      "say": "tut.textfont.4",
      "value": {
        "#tfSize": "10"
      },
      "wait": 1000
    },
    {
      "click": "#textFontWinClose",
      "wait": 300
    }
  ]
}
