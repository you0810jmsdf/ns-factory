{
  "id": "stitch", "page": "stitching", "title": "tut.stitch.title",
  "steps": [
    { "say": "tut.stitch.1", "click": "[data-tool=\"line\"]", "mode": "line" },
    { "drag": [20, 40, 140, 40], "wait": 500 },
    { "say": "tut.stitch.2", "click": "[data-tool=\"stitch\"]", "mode": "stitch" },
    { "say": "tut.stitch.3", "value": { "#placement": "variable" } },
    { "say": "tut.stitch.4", "mouse": [80, 40], "press": true, "wait": 900 },
    { "say": "tut.stitch.5", "click": "#allDots", "wait": 900 },
    { "say": "tut.stitch.6", "click": "#restoreMarks", "wait": 600 }
  ]
}
